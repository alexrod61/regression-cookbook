{
  "description": "Entirely synthetic transit satisfaction; one independent passenger per sampled service run.",
  "rows": 1800,
  "seed": 1515,
  "split_seed": 1516,
  "training_rows": 900,
  "testing_rows": 900,
  "response": "satisfaction",
  "response_order": [
    "Very dissatisfied",
    "Dissatisfied",
    "Satisfied",
    "Very satisfied"
  ],
  "categorical_levels": {
    "crowding": [
      "Low",
      "Moderate",
      "High"
    ],
    "arrival_information": [
      "No",
      "Yes"
    ]
  },
  "identifier_not_predictor": "passenger_id",
  "missing_values_injected": false,
  "continuous_units": {
    "wait_minutes": "minutes",
    "journey_minutes": "minutes"
  },
  "formula": "logit P(Y <= j | x) = alpha_j - eta - information_slope_j * I(information == Yes)",
  "eta": "wait_slope * (wait_minutes - 10)/5 + duration_slope * (journey_minutes - 35)/15 + crowding_slope",
  "thresholds": [
    -1.35,
    -0.1,
    1.1
  ],
  "information_slopes": [
    1.3,
    0.65,
    0.1
  ],
  "wait_slope": -0.7,
  "duration_slope": -0.12,
  "crowding_slopes": {
    "Low": 0.0,
    "Moderate": -0.5,
    "High": -1.1
  },
  "plot_samples": "Observed plots: training only. Generating curves: fixed hypothetical profiles.",
  "versions": {
    "python": "3.11.5",
    "numpy": "1.26.4",
    "pandas": "2.2.3",
    "matplotlib": "3.9.2"
  }
}
